    {
      "id": "rad-zone-corps-unit-taking-cover",
      "targets": [
        {
          "detachmentId": "detachment-rad-zone-corps",
          "ruleId": "rad-zone-corps-rule",
          "field": "text",
          "expectedBefore": null,
          "effectiveAfter": "BATTLE ROUND1BOMBARDMENTAt the start of the first battle round, for each enemy unit within your opponent’s deployment zone, your opponent must decide whether that unit will take cover or stand firm. You then roll one D6 for each of those enemy units and apply the relevant result below:Unit Standing Firm: On a 3+, that unit suffers D3 mortal wounds.Unit Taking Cover: That unit is battle-shocked. On a 5+, that unit suffers D3 mortal woundsBATTLE ROUND2    ONWARDSFALLOUTAt the start of your Command phase during the second, third, fourth and fifth battle rounds, roll one D6 for each enemy unit within your opponent’s deployment zone. On a 3+, that unit suffers 1 mortal wound and must take a Battle-shock test.",
          "glossaryTermId": "adeptus-mechanicus-detachment-rule-rad-bombardment",
          "kind": "detachment-rule",
          "unavailableReason": null
        }
      ],
      "source": {
        "documentId": "adeptus-mechanicus-faction-pack-v1.1",
        "page": 17
      }
    },
