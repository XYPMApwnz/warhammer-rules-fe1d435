agem surface" data-rule-id="stratagem-a-trap-well-laid" data-eligibility="{&quot;v&quot;:1,&quot;roles&quot;:[{&quot;id&quot;:&quot;friendly-target&quot;,&quot;side&quot;:&quot;friendly&quot;,&quot;subject&quot;:&quot;unit&quot;,&quot;count&quot;:1,&quot;selector&quot;:{&quot;allKeywords&quot;:[&quot;KROOT&quot;]}}],&quot;conditions&quot;:[&quot;not-selected-to-shoot-or-fight&quot;]}"><div class="stratagem-head"><div><h3><button class="term-button" data-term="tau-empire-stratagem-a-trap-well-laid" data-term-title="A TRAP WELL LAID" data-term-summary="Your Shooting phase or the Fight phase. One KROOT unit from your army that has not been selected to shoot or fight this phase. After your unit has resolved its attacks this phase, select one enemy unit that was hit by one or more of those attacks. Until the end of the phase, each time a KROOT model from your army makes an attack that targets that enemy unit, unless the attacking unit is Battle-shocked, improve the Armour Penetration characteristic of that attack by 1." data-full-rule-path="books/tau-empire/reader.html#detachment-kroot-hunting-pack" data-mobile-rule-path="books/tau-empire/mobile/kroot-hunting-pack.html#detachment-kroot-hunting-pack">A TRAP WELL LAID</button></h3></div><div class="cp">1CP</div></div><p class="field" data-source-field="when"><b>When</b><br>Your Shooting phase or the Fight phase.</p><p class="field" data-source-field="target"><b>Target</b><br>One KROOT unit from your army that has not been selected to shoot or fight this phase.</p><p class="field" data-source-field="effect"><b>Effect</b><br>After your unit has resolved its attacks this phase, select one enemy unit that was hit by one or more of those attacks. Until the end of the phase, each time a KROOT model from your army makes an attack that targets that enemy unit, unless the attacking unit is Battle-shocked, improve the Armour Penetration characteristic of that attack by 1.</p></article><article class="stratagem surface" data-rule-id=