      "field": "summary",
      "semanticSource": {
        "documentId": "core-rules",
        "locator": "01.02.09",
        "revision": "11e"
      },
      "summary": "Tokens are reminders for limited-use abilities or ongoing effects and have no rules effect unless a rule says otherwise.",
      "termId": "core-rule-01-02-09-tokens"
    },
    {
